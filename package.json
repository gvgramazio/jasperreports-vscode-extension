{
  "name": "jasperreports",
  "displayName": "JasperReports",
  "description": "Viewer & editor for Jasper files and projects",
  "version": "2.5.0",
  "publisher": "gvgramazio",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:jrxml",
    "onLanguage:jrtx"
  ],
  "main": "./dist/extension.js",
  "icon": "images/icon.png",
  "extensionDependencies": [],
  "extensionPack": [],
  "contributes": {
    "languages": [
      {
        "id": "jrxml",
        "aliases": [
          "JasperReports JRXML",
          "JRXML"
        ],
        "extensions": [
          ".jrxml"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "jrtx",
        "aliases": [
          "JasperReports Template",
          "JRTX"
        ],
        "extensions": [
          ".jrtx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jrxml",
        "scopeName": "text.xml.jrxml",
        "path": "./syntaxes/jrxml.tmLanguage.json"
      },
      {
        "language": "jrtx",
        "scopeName": "text.xml.jrtx",
        "path": "./syntaxes/jrtx.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "jrxml",
        "path": "./snippets/jrxml.json"
      }
    ],
    "xmlLanguageParticipants": [
      {
        "languageId": "jrxml"
      },
      {
        "languageId": "jrtx"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jasperreports-panel",
          "title": "JasperReports",
          "icon": "images/jasperreports-panel.svg"
        }
      ]
    },
    "views": {
      "jasperreports-panel": [
        {
          "id": "jasperreports-outline",
          "name": "Report Outline"
        },
        {
          "id": "jasperreports-properties",
          "name": "Properties",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "jasperreports-outline",
        "contents": "Open a .jrxml file to see the report outline."
      },
      {
        "view": "jasperreports-properties",
        "contents": "Select an element in the Report Outline to view its properties."
      }
    ],
    "commands": [
      {
        "command": "jasperreports.compile",
        "title": "Compile JRXML",
        "category": "JasperReports"
      },
      {
        "command": "jasperreports.preview",
        "title": "Preview Report",
        "category": "JasperReports"
      },
      {
        "command": "jasperreports.previewToSide",
        "title": "Preview Report to the Side",
        "category": "JasperReports"
      },
      {
        "command": "jasperreports.downloadDependencies",
        "title": "Download Dependencies",
        "category": "JasperReports"
      },
      {
        "command": "jasperreports.configurePreview",
        "title": "Configure Preview",
        "category": "JasperReports"
      },
      {
        "command": "jasperreports.outline.reveal",
        "title": "Go to Element",
        "category": "JasperReports"
      },
      {
        "command": "jasperreports.outline.add",
        "title": "Add Element",
        "category": "JasperReports",
        "icon": "$(add)"
      },
      {
        "command": "jasperreports.outline.delete",
        "title": "Delete Element",
        "category": "JasperReports",
        "icon": "$(trash)"
      },
      {
        "command": "jasperreports.outline.duplicate",
        "title": "Duplicate Element",
        "category": "JasperReports",
        "icon": "$(copy)"
      },
      {
        "command": "jasperreports.outline.addSection",
        "title": "Add Section",
        "category": "JasperReports"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "jasperreports.compile",
          "when": "editorLangId == jrxml"
        },
        {
          "command": "jasperreports.preview",
          "when": "editorLangId == jrxml"
        },
        {
          "command": "jasperreports.previewToSide",
          "when": "editorLangId == jrxml"
        },
        {
          "command": "jasperreports.configurePreview",
          "when": "editorLangId == jrxml"
        },
        {
          "command": "jasperreports.outline.reveal",
          "when": "false"
        },
        {
          "command": "jasperreports.outline.add",
          "when": "false"
        },
        {
          "command": "jasperreports.outline.delete",
          "when": "false"
        },
        {
          "command": "jasperreports.outline.duplicate",
          "when": "false"
        },
        {
          "command": "jasperreports.outline.addSection",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "jasperreports.outline.add",
          "when": "view == jasperreports-outline && viewItem =~ /^(group-(fields|parameters|variables|sortFields|groups|styles)|section|band|group)$/",
          "group": "inline"
        },
        {
          "command": "jasperreports.outline.delete",
          "when": "view == jasperreports-outline && viewItem =~ /^(style|parameter|field|variable|sortField|group|groupHeader|groupFooter|section|band|element)$/",
          "group": "inline"
        },
        {
          "command": "jasperreports.outline.duplicate",
          "when": "view == jasperreports-outline && viewItem =~ /^(style|parameter|field|variable|sortField|group|band|element)$/",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "JasperReports",
      "properties": {
        "jasperreports.schema.version": {
          "type": "string",
          "default": "7.0.6",
          "enum": [
            "7.0.6"
          ],
          "description": "JasperReports schema version to use for validation."
        },
        "jasperreports.schema.jrxmlPath": {
          "type": "string",
          "default": "",
          "description": "Path to a custom JRXML XSD schema file. Overrides the bundled schema when set."
        },
        "jasperreports.schema.jrtxPath": {
          "type": "string",
          "default": "",
          "description": "Path to a custom JRTX XSD schema file. Overrides the bundled schema when set."
        },
        "jasperreports.java.home": {
          "type": "string",
          "default": "",
          "description": "Path to a JRE or JDK installation. If empty, uses JAVA_HOME or java on PATH."
        },
        "jasperreports.classpath": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Paths to JasperReports JARs and dependencies. Supports glob patterns (e.g. `/path/to/libs/*`). Required for the compile command."
        },
        "jasperreports.java.sourcePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Directories containing `.java` source files (e.g. custom scriptlets or functions). These are compiled automatically before JRXML compilation. Requires a JDK (`javac`)."
        },
        "jasperreports.preview.format": {
          "type": "string",
          "default": "html",
          "enum": [
            "html",
            "pdf"
          ],
          "description": "Default export format for report preview."
        },
        "jasperreports.preview.liveReload": {
          "type": "boolean",
          "default": false,
          "description": "Automatically re-run preview when the JRXML file is saved."
        },
        "jasperreports.expression.enterBehavior": {
          "type": "string",
          "default": "commit",
          "enum": [
            "commit",
            "newline"
          ],
          "enumDescriptions": [
            "Enter commits the expression. Shift+Enter inserts a newline. Ctrl+Enter / Cmd+Enter also commits.",
            "Enter inserts a newline. Ctrl+Enter / Cmd+Enter commits. Shift+Enter also inserts a newline."
          ],
          "description": "Controls what the Enter key does inside expression textareas in the Properties panel."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gvgramazio/jasperreports-vscode-extension"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/properties/tsconfig.webview.json",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "vsce:package": "vsce package --no-dependencies --allow-star-activation",
    "vsce:publish": "vsce publish --no-dependencies --allow-star-activation --packagePath *.vsix",
    "ovsx:publish": "ovsx publish *.vsix -p $OVSX_PAT",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.5.0",
    "@types/vscode": "~1.110.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "ovsx": "^0.10.12",
    "prettier": "^3.0.0",
    "semantic-release": "^25.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@vscode-elements/elements": "^2.5.1",
    "saxes": "^6.0.0"
  }
}
