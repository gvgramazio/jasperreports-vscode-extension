{
  "name": "jasperreports",
  "displayName": "JasperReports",
  "description": "Viewer & editor for Jasper files and projects",
  "version": "0.0.1",
  "publisher": "gvgramazio",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:jrxml",
    "onLanguage:jrtx"
  ],
  "main": "./dist/extension.js",
  "icon": "images/icon.png",
  "extensionDependencies": [],
  "extensionPack": [],
  "contributes": {
    "languages": [
      {
        "id": "jrxml",
        "aliases": [
          "JasperReports JRXML",
          "JRXML"
        ],
        "extensions": [
          ".jrxml"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "jrtx",
        "aliases": [
          "JasperReports Template",
          "JRTX"
        ],
        "extensions": [
          ".jrtx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jrxml",
        "scopeName": "text.xml.jrxml",
        "path": "./syntaxes/jrxml.tmLanguage.json"
      },
      {
        "language": "jrtx",
        "scopeName": "text.xml.jrtx",
        "path": "./syntaxes/jrtx.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "jrxml",
        "path": "./snippets/jrxml.json"
      }
    ],
    "xmlLanguageParticipants": [
      {
        "languageId": "jrxml"
      },
      {
        "languageId": "jrtx"
      }
    ],
    "commands": [
      {
        "command": "jasperreports.compile",
        "title": "Compile JRXML",
        "category": "JasperReports"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "jasperreports.compile",
          "when": "editorLangId == jrxml"
        }
      ]
    },
    "configuration": {
      "title": "JasperReports",
      "properties": {
        "jasperreports.schema.version": {
          "type": "string",
          "default": "7.0.6",
          "enum": [
            "7.0.6"
          ],
          "description": "JasperReports schema version to use for validation."
        },
        "jasperreports.schema.jrxmlPath": {
          "type": "string",
          "default": "",
          "description": "Path to a custom JRXML XSD schema file. Overrides the bundled schema when set."
        },
        "jasperreports.schema.jrtxPath": {
          "type": "string",
          "default": "",
          "description": "Path to a custom JRTX XSD schema file. Overrides the bundled schema when set."
        },
        "jasperreports.java.home": {
          "type": "string",
          "default": "",
          "description": "Path to a JRE or JDK installation. If empty, uses JAVA_HOME or java on PATH."
        },
        "jasperreports.classpath": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Paths to JasperReports JARs and dependencies. Supports glob patterns (e.g. `/path/to/libs/*`). Required for the compile command."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gvgramazio/jasperreports-vscode-extension"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "vsce:package": "vsce package --no-dependencies --allow-star-activation",
    "vsce:publish": "vsce publish --no-dependencies --allow-star-activation --packagePath *.vsix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@types/vscode": "~1.110.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.0.0",
    "semantic-release": "^25.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
