  </xs:complexType>

  <!-- query -->
  <xs:complexType name="queryType" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="language" type="xs:string"/>
  </xs:complexType>

  <!-- group -->
  <xs:complexType name="groupType">
    <xs:sequence>
      <xs:element name="expression" type="expressionType" minOccurs="0"/>
      <xs:element name="groupHeader" minOccurs="0">
        <xs:complexType>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="band" type="bandType"/>
            <xs:element name="part" type="partType"/>
          </xs:choice>
        </xs:complexType>
      </xs:element>
      <xs:element name="groupFooter" minOccurs="0">
