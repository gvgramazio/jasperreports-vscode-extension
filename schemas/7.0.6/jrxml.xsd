  <!--  Top-level child types                                             -->
  <!-- ================================================================== -->

  <!-- style -->
  <xs:complexType name="styleType">
    <xs:sequence>
      <xs:element name="conditionalStyle" type="conditionalStyleType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="box" type="boxType" minOccurs="0"/>
      <xs:element name="pen" type="penType" minOccurs="0"/>
      <xs:element name="paragraph" type="paragraphType" minOccurs="0"/>
