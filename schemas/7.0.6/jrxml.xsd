    <xs:attribute name="preventOrphanFooter" type="xs:boolean"/>
  </xs:complexType>

  <!-- dataset (subDataset) -->
  <xs:complexType name="datasetType">
    <xs:sequence>
      <xs:element name="property" type="propertyType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="propertyExpression" type="propertyExpressionType" minOccurs="0" maxOccurs="unbounded"/>
