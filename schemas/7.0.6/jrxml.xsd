  <xs:complexType name="crosstabCellType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="contents" type="contentsType"/>
      <xs:element name="element" type="elementType"/>
      <xs:element name="box" type="boxType"/>
    </xs:choice>
    <xs:attribute name="style" type="xs:string"/>
    <xs:attribute name="width" type="xs:int"/>
    <xs:attribute name="height" type="xs:int"/>
    <xs:attributeGroup ref="styleAttributes"/>
  </xs:complexType>

  <!-- contents type (used in crosstab cells and components) -->
  <xs:complexType name="contentsType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="element" type="elementType"/>
      <xs:element name="box" type="boxType"/>
