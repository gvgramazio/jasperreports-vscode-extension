      <!-- expression (textField, image, subreport, etc.) -->
      <xs:element name="expression" type="expressionType"/>
      <xs:element name="patternExpression" type="expressionType"/>
      <xs:element name="anchorNameExpression" type="expressionType"/>
      <xs:element name="bookmarkLevelExpression" type="expressionType"/>

      <!-- hyperlink expressions -->
      <xs:element name="hyperlinkReferenceExpression" type="expressionType"/>
      <xs:element name="hyperlinkAnchorExpression" type="expressionType"/>
      <xs:element name="hyperlinkPageExpression" type="expressionType"/>
      <xs:element name="hyperlinkTooltipExpression" type="expressionType"/>
      <xs:element name="hyperlinkParameter" type="hyperlinkParameterType"/>

      <!-- box, pen, paragraph -->
      <xs:element name="box" type="boxType"/>
      <xs:element name="pen" type="penType"/>
      <xs:element name="paragraph" type="paragraphType"/>

      <!-- subreport children -->
      <xs:element name="connectionExpression" type="expressionType"/>
      <xs:element name="dataSourceExpression" type="expressionType"/>
      <xs:element name="returnValue" type="returnValueType"/>
      <xs:element name="parameter" type="subreportParameterType"/>

      <!-- generic element children -->
      <xs:element name="genericType" type="genericTypeType"/>

      <!-- additional element children -->
      <xs:element name="borderSplitType" type="expressionType"/>
      <xs:element name="titleExpression" type="expressionType"/>
      <xs:element name="subtitleExpression" type="expressionType"/>

      <!-- chart children -->
      <xs:element name="chartTitle" type="chartTitleType"/>
      <xs:element name="chartSubtitle" type="chartTitleType"/>
      <xs:element name="chartLegend" type="chartTitleType"/>
      <xs:element name="dataset" type="chartDatasetType"/>
      <xs:element name="plot" type="chartPlotType"/>

      <!-- component children -->
      <xs:element name="component">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="datasetRun" type="datasetRunType" minOccurs="0"/>
            <xs:element name="contents" minOccurs="0">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="element" type="elementType" minOccurs="0" maxOccurs="unbounded"/>
                </xs:sequence>
                <xs:attribute name="height" type="xs:int"/>
                <xs:attribute name="width" type="xs:int"/>
              </xs:complexType>
            </xs:element>
            <xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/>
          </xs:sequence>
          <xs:attribute name="kind" type="xs:string"/>
          <xs:attribute name="printOrder" type="printOrderType"/>
