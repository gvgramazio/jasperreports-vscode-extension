    <xs:attribute name="pdfEncoding" type="xs:string"/>
    <xs:attribute name="pdfEmbedded" type="xs:boolean"/>
  </xs:complexType>

  <!-- conditionalStyle -->
  <xs:complexType name="conditionalStyleType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="conditionExpression" type="expressionType"/>
      <xs:element name="box" type="boxType"/>
      <xs:element name="pen" type="penType"/>
      <xs:element name="paragraph" type="paragraphType"/>
    </xs:choice>
    <xs:attributeGroup ref="styleAttributes"/>
  </xs:complexType>

  <!-- shared style attributes -->
  <xs:attributeGroup name="styleAttributes">
    <xs:attribute name="mode" type="modeType"/>
    <xs:attribute name="forecolor" type="xs:string"/>
    <xs:attribute name="backcolor" type="xs:string"/>
    <xs:attribute name="fontName" type="xs:string"/>
    <xs:attribute name="fontSize" type="xs:decimal"/>
    <xs:attribute name="bold" type="xs:boolean"/>
    <xs:attribute name="italic" type="xs:boolean"/>
    <xs:attribute name="underline" type="xs:boolean"/>
    <xs:attribute name="strikeThrough" type="xs:boolean"/>
    <xs:attribute name="pdfFontName" type="xs:string"/>
    <xs:attribute name="pdfEncoding" type="xs:string"/>
    <xs:attribute name="pdfEmbedded" type="xs:boolean"/>
    <xs:attribute name="hTextAlign" type="horizontalTextAlignType"/>
    <xs:attribute name="vTextAlign" type="verticalTextAlignType"/>
    <xs:attribute name="hImageAlign" type="horizontalImageAlignType"/>
    <xs:attribute name="vImageAlign" type="verticalImageAlignType"/>
    <xs:attribute name="rotation" type="rotationType"/>
    <xs:attribute name="markup" type="xs:string"/>
    <xs:attribute name="pattern" type="xs:string"/>
    <xs:attribute name="blankWhenNull" type="xs:boolean"/>
    <xs:attribute name="radius" type="xs:int"/>
    <xs:attribute name="scaleImage" type="scaleImageType"/>
    <xs:attribute name="fill" type="xs:string"/>
  </xs:attributeGroup>

  <!-- ================================================================== -->
  <!--  The <element> type — polymorphic via the "kind" attribute         -->
  <!-- ================================================================== -->

  <xs:complexType name="elementType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
