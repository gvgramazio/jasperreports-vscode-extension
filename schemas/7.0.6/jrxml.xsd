    <xs:attribute name="usingCache" type="xs:boolean"/>
    <xs:attribute name="lazy" type="xs:boolean"/>

    <!-- line attributes -->
    <xs:attribute name="direction" type="lineDirectionType"/>

    <!-- break attributes -->
    <xs:attribute name="type" type="breakType"/>

    <!-- chart attributes -->
    <xs:attribute name="chartType" type="xs:string"/>
