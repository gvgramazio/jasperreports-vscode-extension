    </xs:choice>
    <xs:attributeGroup ref="styleAttributes"/>
    <xs:attribute name="style" type="xs:string"/>
    <xs:attribute name="height" type="xs:int"/>
    <xs:attribute name="width" type="xs:int"/>
  </xs:complexType>

  <!-- part type (used in book-style reports with sectionType="Part") -->
  <xs:complexType name="partType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="property" type="propertyType"/>
      <xs:element name="propertyExpression" type="propertyExpressionType"/>
      <xs:element name="partNameExpression" type="expressionType"/>
      <xs:element name="component">
        <xs:complexType>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="expression" type="expressionType"/>
            <xs:element name="parameter" type="subreportParameterType"/>
            <xs:element name="returnValue" type="returnValueType"/>
            <xs:element name="connectionExpression" type="expressionType"/>
            <xs:element name="dataSourceExpression" type="expressionType"/>
