        </xs:complexType>
      </xs:element>

      <!-- crosstab children -->
      <xs:element name="rowGroup">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="bucket" type="bucketType" minOccurs="0"/>
            <xs:element name="header" type="crosstabCellType" minOccurs="0"/>
            <xs:element name="totalHeader" type="crosstabCellType" minOccurs="0"/>
          </xs:sequence>
          <xs:attribute name="name" type="xs:string" use="required"/>
          <xs:attribute name="width" type="xs:int"/>
          <xs:attribute name="totalPosition" type="xs:string"/>
          <xs:attribute name="headerPosition" type="xs:string"/>
          <xs:attribute name="position" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="columnGroup">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="bucket" type="bucketType" minOccurs="0"/>
            <xs:element name="header" type="crosstabCellType" minOccurs="0"/>
            <xs:element name="totalHeader" type="crosstabCellType" minOccurs="0"/>
          </xs:sequence>
          <xs:attribute name="name" type="xs:string" use="required"/>
          <xs:attribute name="height" type="xs:int"/>
          <xs:attribute name="totalPosition" type="xs:string"/>
          <xs:attribute name="headerPosition" type="xs:string"/>
          <xs:attribute name="position" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="measure">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="expression" type="expressionType" minOccurs="0"/>
          </xs:sequence>
          <xs:attribute name="name" type="xs:string" use="required"/>
          <xs:attribute name="class" type="xs:string"/>
          <xs:attribute name="calculation" type="calculationType"/>
          <xs:attribute name="percentageOf" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="cell">
        <xs:complexType>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="contents" type="contentsType"/>
            <xs:element name="element" type="elementType"/>
            <xs:element name="box" type="boxType"/>
          </xs:choice>
          <xs:attribute name="width" type="xs:int"/>
          <xs:attribute name="height" type="xs:int"/>
          <xs:attribute name="rowTotalGroup" type="xs:string"/>
          <xs:attribute name="columnTotalGroup" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="whenNoDataCell">
        <xs:complexType>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="contents" type="contentsType"/>
            <xs:element name="element" type="elementType"/>
          </xs:choice>
          <xs:attribute name="width" type="xs:int"/>
          <xs:attribute name="height" type="xs:int"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="headerCell">
        <xs:complexType>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="contents" type="contentsType"/>
            <xs:element name="element" type="elementType"/>
            <xs:element name="box" type="boxType"/>
          </xs:choice>
          <xs:attribute name="width" type="xs:int"/>
          <xs:attribute name="height" type="xs:int"/>
        </xs:complexType>
      </xs:element>

      <!-- nested elements (frame, elementGroup) -->
      <xs:element name="element" type="elementType"/>
    </xs:choice>

    <!-- Common element attributes -->
    <xs:attribute name="kind" type="elementKindType"/>
    <xs:attribute name="uuid" type="xs:string"/>
    <xs:attribute name="key" type="xs:string"/>
    <xs:attribute name="style" type="xs:string"/>
    <xs:attribute name="x" type="xs:int"/>
    <xs:attribute name="y" type="xs:int"/>
    <xs:attribute name="width" type="xs:int"/>
    <xs:attribute name="height" type="xs:int"/>

    <xs:attributeGroup ref="styleAttributes"/>

    <xs:attribute name="positionType" type="positionType"/>
    <xs:attribute name="stretchType" type="stretchType"/>
    <xs:attribute name="printRepeatedValues" type="xs:boolean"/>
    <xs:attribute name="removeLineWhenBlank" type="xs:boolean"/>
    <xs:attribute name="printInFirstWholeBand" type="xs:boolean"/>
    <xs:attribute name="printWhenDetailOverflows" type="xs:boolean"/>
    <xs:attribute name="printWhenGroupChanges" type="xs:string"/>

    <!-- text/textField attributes -->
    <xs:attribute name="textAdjust" type="textAdjustType"/>
    <xs:attribute name="evaluationTime" type="evaluationTimeType"/>
    <xs:attribute name="evaluationGroup" type="xs:string"/>
    <xs:attribute name="bookmarkLevel" type="xs:int"/>

    <!-- hyperlink attributes -->
    <xs:attribute name="linkType" type="xs:string"/>
